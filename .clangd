CompileFlags:
  CompilationDatabase: build_ios_metal
  Add:
    # iOS SDK
    - -isysroot
    - /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk
    # Target arm64 iOS (matches ios_metal_build.sh)
    - -target
    - arm64-apple-ios16.0
    # C++17 (matches VTK's cmake CMAKE_CXX_STANDARD=17)
    - -std=gnu++17

---
# .mm: Objective-C++ (VTK Metal, iOS examples, Cocoa)
If:
  PathMatch: .*\.mm$
CompileFlags:
  Add:
    - -x
    - objective-c++
    - -std=gnu++17
    - -fobjc-arc

---
# .m: Objective-C
If:
  PathMatch: .*\.m$
CompileFlags:
  Add:
    - -x
    - objective-c
    - -fobjc-arc

---
# pure C++ files
If:
  PathMatch: .*\.(cpp|hpp|cxx|cc|c)$
CompileFlags:
  Add:
    - -x
    - c++
    - -std=gnu++17
