CompileFlags:
  # Symlink to the active build's compile_commands.json, managed by clangd_switch.sh
  CompilationDatabase: .clangd-db
  Add:
    # C++17 (matches VTK's cmake CMAKE_CXX_STANDARD=17)
    - -std=gnu++17

---
# .mm: Objective-C++ (VTK Metal, iOS examples, Cocoa)
If:
  PathMatch: .*\.mm$
CompileFlags:
  Add:
    - -x
    - objective-c++
    - -std=gnu++17

---
# .m: Objective-C
If:
  PathMatch: .*\.m$
CompileFlags:
  Add:
    - -x
    - objective-c

---
# pure C++ files
If:
  PathMatch: .*\.(cpp|hpp|cxx|cc|c)$
CompileFlags:
  Add:
    - -x
    - c++
    - -std=gnu++17
