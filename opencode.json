{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "lsp": {
    "clangd": {
      "command": ["clangd"],
      "extensions": [".c", ".cpp", ".cc", ".cxx", ".h", ".hpp", ".hh", ".m", ".mm"],
      "initialization": {
        "fallbackFlags": ["-std=gnu++17"]
      }
    },
    "sourcekit-lsp": {
      "disabled": true
    }
  }
}
